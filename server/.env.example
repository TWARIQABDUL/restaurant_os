# Copy to server/.env and fill in real values. NEVER put real secrets in this file.

# Database Connection (for running SQL scripts directly)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- The new database (milestone 11 onward) -----------------------------------
# `npm run db:up` at the repository root starts plain Postgres on port 55432.
# See db/README.md. The credentials below are local and worthless.
#
# THE APPLICATION connects as the least-privilege role. `npm run api:start`
# REFUSES TO BOOT without this, and refuses a connection string belonging to the
# schema owner: the app owns nothing and runs no DDL, and a connection with DDL
# rights turns a stray statement into a schema change.
APP_DATABASE_URL=postgresql://vendlyfy_app:localdev@127.0.0.1:55432/vendlyfy

# Migrations, seeds and psql run as the owner role, and the db:* scripts supply
# this themselves from docker-compose.yml — set it only to point them somewhere
# else. It is deliberately NOT what the application uses.
# DATABASE_URL=postgresql://vendlyfy_owner:localdev@127.0.0.1:55432/vendlyfy
#
# Milestone 30's cutover switch (middleware/writeFreeze.ts), shared by both the legacy app and this
# one. none/off (default): every request behaves normally. on: every mutating request (POST/PUT/
# PATCH/DELETE) is refused with 503; GET/HEAD/OPTIONS still work. Read live on every request, so
# flipping it takes effect without a restart — only ever set this during the actual freeze window.
# WRITE_FREEZE=off
#
# Port 55432, not 5432, on purpose: a mistyped host then fails to connect
# instead of reaching a real database.
#
# The new server listens here; the legacy one keeps PORT below, so both can run
# side by side until cutover.
API_PORT=5100
#
# Tuning, all optional — the defaults in server/src/db/pool.ts are the shipped
# values. Raise PGPOOL_MAX with evidence from pg_stat_activity, not by guessing.
# PGPOOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=15000
# PG_LOCK_TIMEOUT=5s
# PG_SLOW_QUERY_MS=200
# PG_TX_RETRIES=3
#
# Deliberate escape hatch, named explicitly so the choice is visible: allows the
# application to connect as the schema owner. For a local experiment only.
# APP_DB_ALLOW_OWNER=true
#
# Where the new server reads this file from. Defaults to server/.env. A deployment
# keeping it elsewhere sets this; the boot tests point it at a path that does not
# exist, which is the only way "refuses to start without APP_DATABASE_URL" can be
# asserted on a machine that has a server/.env.
# ENV_FILE=/etc/vendlyfy/api.env
# -----------------------------------------------------------------------------

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SERVER ONLY — bypasses RLS. Never expose to the client, never prefix with VITE_.
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public key. Safe to expose; the client bundle carries it for Storage uploads.
# Only used server-side by scripts/verify-lockdown.js.
SUPABASE_ANON_KEY=your_anon_key

JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=24h

# SendGrid — used by the legacy server (config/email.js) AND the new one (server/src/messaging/sendgridTransport.ts).
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@example.com

# The new server's messaging transport seam (milestone 28; see server/src/messaging/transport.ts).
# MESSAGING_EMAIL: none (default, nothing sent) | log (dev: prints instead of sending) | sendgrid (real email)
# MESSAGING_SMS:   none (default) | log | twilio (real SMS — decided 2026-10-20, not live until the account below
#                  is funded; leave MESSAGING_SMS unset/none until then so the queue visibly waits rather than
#                  trying real sends against an unfunded account)
MESSAGING_EMAIL=sendgrid
MESSAGING_SMS=none

# Twilio (https://www.twilio.com/docs/messaging) — server/src/messaging/twilioTransport.ts. Set MESSAGING_SMS=twilio
# once the account can actually send; until then these can sit filled in with no effect.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Server — the LEGACY app (server/src/server.js), on supabase-js until cutover.
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# NEW server (server/src/api) — where product photos are written by the LOCAL image driver (milestone 22).
# Defaults to server/.media, which is git-ignored. Development and tests only.
# MEDIA_DIR=

# Production storage, decided 2026-10-20: MinIO, for BOTH the public media store (above) and the private
# KYC/evidence store (below). MEDIA_STORE / PRIVATE_STORE: local (default, dev/tests) | minio. The two switches
# are independent on purpose — see server/src/storage/private.ts's header for why the private store's
# production-readiness was never coupled to the image store's.
# MEDIA_STORE=minio
# PRIVATE_STORE=minio
# MINIO_ENDPOINT=127.0.0.1
# MINIO_PORT=59000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=vendlyfy_minio
# MINIO_SECRET_KEY=localdev_minio
# MINIO_MEDIA_BUCKET=vendlyfy-media
# MINIO_PRIVATE_BUCKET=vendlyfy-private

# NEW server — the settlement loop (jobs/settlement.ts): releases escrow, pays automatic payouts, re-reads payouts
# still waiting on MoMo. On by default; set to `off` in a process that should not run it. MOMO_HOLD_MINUTES (above)
# is the hold window, MOMO_SCHEDULER_INTERVAL_MS the tick, and the MOMO_DISBURSEMENT_* trio is what a payout needs.
# SETTLEMENT_SCHEDULER=off

MOMO_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=EUR
MOMO_DEFAULT_COUNTRY_CODE=250

# Payment provider decided 2026-10-25: Urubuto Pay for collections (checkout). See payments/urubuto.ts.
# Disbursements (payouts) stay on the MOMO_DISBURSEMENT_* vars above until that integration is built —
# DISBURSEMENT_PROVIDER switches it later with no deploy (payments/disbursements.ts).
# DISBURSEMENT_PROVIDER=momo
URUBUTO_BASE_URL=https://staging.urubutopay.rw/api
URUBUTO_API_KEY=
URUBUTO_MERCHANT_CODE=
URUBUTO_SERVICE_CODE=
URUBUTO_HTTP_TIMEOUT_MS=15000

# The webhook auth handshake is INVERTED from MoMo's: Urubuto Pay calls OUR /api/urubuto/webhook/auth with
# {user_name, password} WE issue it, and we hand back a JWT (signed with URUBUTO_JWT_SECRET) it then
# presents on /api/urubuto/webhook/callback. Generate your own — these are not Urubuto Pay's secrets.
#   URUBUTO_WEBHOOK_USERNAME       whatever you tell Urubuto Pay to send as user_name.
#   URUBUTO_WEBHOOK_PASSWORD_HASH  bcrypt hash (never plaintext) of the password you tell Urubuto Pay to send.
#   URUBUTO_JWT_SECRET             openssl rand -base64 32, at least 32 chars. Different from JWT_SECRET.
#   URUBUTO_WEBHOOK_TOKEN_TTL      default 24h; Urubuto Pay's own webhook calls need it to outlive their retries.
URUBUTO_WEBHOOK_USERNAME=
URUBUTO_WEBHOOK_PASSWORD_HASH=
URUBUTO_JWT_SECRET=
URUBUTO_WEBHOOK_TOKEN_TTL=24h

# NEW server — identity verification (milestone 26). Generate each value yourself; never reuse across environments.
#   KYC_ENCRYPTION_KEY       openssl rand -base64 32   seals ID photos and ID numbers (AES-256-GCM). LOSING IT MAKES
#                            EVERY STORED DOCUMENT UNREADABLE — keep a copy somewhere safe, away from the database.
#   KYC_ENCRYPTION_KEY_ID    optional name for that key, recorded beside what it sealed (default env-1).
#   KYC_ENCRYPTION_KEYS      optional rotation form: id:base64,id:base64 — the first seals, any opens.
#   KYC_FINGERPRINT_PEPPER   openssl rand -hex 32      keys the duplicate-detection hash; separate from the key above.
#   PRIVATE_DIR              where the LOCAL driver keeps sealed documents (default server/.private, git-ignored).
#                            Production uses MinIO instead — see PRIVATE_STORE above.
KYC_ENCRYPTION_KEY=
KYC_FINGERPRINT_PEPPER=
