{
  "rewrites": [
    {
      "source": "/:slug(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|twitterbot|facebookexternalhit|slackbot|linkedinbot|pinterest|skypeuripreview|discordbot|telegrambot|vkshare|discord|applebot).*"
        }
      ],
      "destination": "/api/seo"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
