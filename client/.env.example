# Copy to client/.env. ONLY VITE_-prefixed variables belong here — Vite inlines
# every VITE_* value into the browser bundle, so anything here is public.
#
# Server secrets (DATABASE_URL, JWT_SECRET, SENDGRID_API_KEY, and above all
# SUPABASE_SERVICE_ROLE_KEY) belong in server/.env and must never appear in
# this file, prefixed or not.

VITE_SUPABASE_URL=
# Public by design. Since lockdown-anon.sql it holds no database privileges,
# and since lockdown-storage.sql no storage write privileges either.
VITE_SUPABASE_ANON_KEY=

# Optional. Defaults to the same-origin '/backend' rewrite (see vercel.json).
VITE_API_URL=
