{
  "name": "vendlyfy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Vendlyfy \u2014 repository root. Carries the db:* scripts for the local Postgres container and the migration runner. Workspaces (client, server, packages/core) arrive at milestone 3.",
  "scripts": {
    "db:up": "bash db/scripts/up.sh",
    "db:down": "bash db/scripts/down.sh",
    "db:reset": "bash db/scripts/reset.sh",
    "db:verify": "bash db/scripts/verify.sh",
    "db:psql": "bash db/scripts/psql.sh",
    "db:logs": "bash db/scripts/logs.sh",
    "db:migrate": "bash db/scripts/migrate.sh",
    "db:migrate:status": "bash db/scripts/migrate.sh status",
    "db:migrate:new": "bash db/scripts/migrate.sh new",
    "db:types": "bash db/scripts/gen-types.sh",
    "db:seed": "bash db/scripts/seed.sh",
    "db:test": "bash db/scripts/test.sh",
    "api:test": "bash scripts/api-test.sh",
    "core:test": "node --test packages/core/test/*.test.ts",
    "db:profile": "bash db/scripts/profile-old-db.sh",
    "etl:rehearse": "bash db/scripts/etl-rehearse.sh",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core && tsc -p packages/core/tsconfig.test.json && tsc -p server && tsc -p client && tsc -p client/tsconfig.check.json",
    "check:styles": "node scripts/check-styles.ts",
    "ui:check": "npm --prefix client run ui:check"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
