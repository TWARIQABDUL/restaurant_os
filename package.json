{
  "name": "vendlyfy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Vendlyfy — repository root. Carries the db:* scripts for the local Postgres container and the migration runner. Workspaces (client, server, packages/core) arrive at milestone 3.",
  "scripts": {
    "db:up": "bash db/scripts/up.sh",
    "db:down": "bash db/scripts/down.sh",
    "db:reset": "bash db/scripts/reset.sh",
    "db:verify": "bash db/scripts/verify.sh",
    "db:psql": "bash db/scripts/psql.sh",
    "db:logs": "bash db/scripts/logs.sh",
    "db:migrate": "bash db/scripts/migrate.sh",
    "db:migrate:status": "bash db/scripts/migrate.sh status",
    "db:migrate:new": "bash db/scripts/migrate.sh new",
    "db:test": "bash db/scripts/test-migrate.sh"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
